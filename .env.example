# ─── Environnement ───────────────────────────────────────────────
# development | production (en production, les variables marquées
# "requis en prod" sont validées au démarrage de l'API)
NODE_ENV=development

# ─── Base de données ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chiffreo
DB_PASSWORD=chiffreo_dev
DB_NAME=chiffreo

# ─── API ─────────────────────────────────────────────────────────
PORT=3001
# Origines autorisées, séparées par des virgules (requis en prod)
CORS_ORIGIN=http://localhost:3000
# URL publique du frontend, utilisée pour les redirections Stripe (requis en prod)
PUBLIC_URL=http://localhost:3000

# ─── Firebase Admin SDK (backend, requis en prod) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (frontend, figé au build de l'image web) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Stripe (requis en prod) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Plans Contractor (optionnels tant que l'offre n'est pas lancée)
STRIPE_CONTRACTOR_ESSENTIEL_PRICE_ID=
STRIPE_CONTRACTOR_STANDARD_PRICE_ID=
STRIPE_CONTRACTOR_PREMIUM_PRICE_ID=

# ─── Brevo (e-mail transactionnel, requis en prod) ───────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chiffréo

# ─── CV Service ──────────────────────────────────────────────────
CV_SERVICE_URL=http://localhost:8000
CV_SERVICE_TIMEOUT_MS=120000

# ─── Stockage des photos ─────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL publique du site (SEO : sitemap, OpenGraph). Figée au build de l'image web.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Sentry (monitoring, optionnel — no-op si absent) ────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Comparaison de prix ─────────────────────────────────────────
# Fraîcheur du cache de prix fournisseurs, en heures.
PRICE_CACHE_TTL_HOURS=24

# ─── ManoMano (affiliation, optionnel) ───────────────────────────
# Flux produits du programme d'affiliation, fourni par la plateforme
# (Awin, Effiliation…). L'URL porte le jeton du programme : ne jamais la
# committer. Un chemin local ou une URL file:// sont acceptés, ce qui permet
# de valider le rapprochement catalogue→produits sur un extrait de flux.
# Sans MANOMANO_ENABLED=true, aucun adaptateur n'est enregistré et la
# comparaison de prix ne renvoie rien.
MANOMANO_ENABLED=false
MANOMANO_FEED_URL=
MANOMANO_TIMEOUT_MS=120000
MANOMANO_FEED_TTL_HOURS=24
