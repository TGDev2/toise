# ─── Environnement ───────────────────────────────────────────────
# development | production (en production, les variables marquées
# "requis en prod" sont validées au démarrage de l'API)
NODE_ENV=development

# ─── Base de données ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=estimate
DB_PASSWORD=estimate_dev
DB_NAME=estimate

# ─── API ─────────────────────────────────────────────────────────
PORT=3001
# Origines autorisées, séparées par des virgules (requis en prod)
CORS_ORIGIN=http://localhost:3000
# URL publique du frontend, utilisée pour les redirections Stripe (requis en prod)
PUBLIC_URL=http://localhost:3000

# ─── Firebase Admin SDK (backend, requis en prod) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (frontend, figé au build de l'image web) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Stripe (requis en prod) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Plans Contractor (optionnels tant que l'offre n'est pas lancée)
STRIPE_CONTRACTOR_ESSENTIEL_PRICE_ID=
STRIPE_CONTRACTOR_STANDARD_PRICE_ID=
STRIPE_CONTRACTOR_PREMIUM_PRICE_ID=

# ─── CV Service ──────────────────────────────────────────────────
CV_SERVICE_URL=http://localhost:8000
CV_SERVICE_TIMEOUT_MS=120000

# ─── Stockage des photos ─────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL publique du site (SEO : sitemap, OpenGraph). Figée au build de l'image web.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Comparaison de prix ─────────────────────────────────────────
# Mock supplier adapters are strictly opt-in (dev/test only). They generate
# fabricated CAD prices and must NEVER be enabled in production until real
# supplier adapters (Home Depot, Lowes, …) are integrated.
PRICE_MOCK_ENABLED=false
