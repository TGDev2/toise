# ─── Environnement ───────────────────────────────────────────────
# development | production (en production, les variables marquées
# "requis en prod" sont validées au démarrage de l'API)
NODE_ENV=development

# ─── Base de données ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chiffreo
# Mot de passe Postgres (requis en prod, 16 caractères minimum). Ne jamais
# laisser une valeur d'exemple : CHANGEME est refusé au démarrage en
# production par env.validation.ts.
DB_PASSWORD=CHANGEME
DB_NAME=chiffreo

# ─── API ─────────────────────────────────────────────────────────
PORT=3001
# Origines autorisées, séparées par des virgules (requis en prod). Doit être
# une URL publique en HTTPS : localhost est refusé au démarrage en production.
CORS_ORIGIN=CHANGEME
# URL publique du frontend, utilisée pour les redirections Stripe (requis en
# prod). Doit être une URL publique en HTTPS : localhost est refusé au
# démarrage en production.
PUBLIC_URL=CHANGEME
# Nombre de reverse proxys de confiance devant l'API (`app.set('trust proxy')`).
# Vide/absent = aucun : `req.ip` est alors l'IP de connexion directe. Derrière un
# proxy sans cette valeur, tout le trafic partage un seul compteur de rate
# limiting ; avec cette valeur sans proxy, l'IP devient falsifiable via
# X-Forwarded-For. Mettre 1 en production derrière Caddy/nginx.
TRUST_PROXY=

# ─── Firebase Admin SDK (backend, requis en prod) ────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (frontend, figé au build de l'image web) ─
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Stripe (requis en prod) ─────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix de l'unique offre payante : Conformité, 279 € HT **par an**, créée en
# récurrence `Yearly` dans Stripe (cf. docs/DEPLOY.md §4.1 — un prix créé en
# `Monthly` facturerait 279 € par mois). Non validé au démarrage : sans lui
# l'API démarre et le checkout répond « Offre invalide ».
#
# STRIPE_PRO_PRICE_ID a disparu avec le palier DIY à 9,99 €/mois (E3-1) ;
# STRIPE_CONTRACTOR_STANDARD_PRICE_ID et ..._PREMIUM_... avec les paliers
# mensuels à 29 et 49 € (E3-3). Ne pas les réintroduire : un prix qui ne résout
# aucun palier se paierait sans rien débloquer.
STRIPE_CONTRACTOR_ESSENTIEL_PRICE_ID=
# Jours d'accès conservés après un échec de paiement, avant retour au palier
# gratuit. Défaut 14 : couvre les trois premières relances Stripe, donc le cas
# de la carte expirée. 0 = déclassement immédiat.
STRIPE_PAST_DUE_GRACE_DAYS=14

# ─── Brevo (e-mail transactionnel, requis en prod) ───────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chiffréo

# ─── CV Service (débranché en production, ADR 0001) ───────────────
# Le service reste utilisable en local pour développer dessus (`pnpm dev:cv`
# ou docker-compose.yml), mais l'API refuse toute analyse tant que
# CV_ENABLED n'est pas explicitement à true — en prod comme en local.
CV_ENABLED=false
CV_SERVICE_URL=http://localhost:8000
# Secret partage avec le service CV (meme valeur cote cv-service).
# Requis des que CV_SERVICE_ENV != development : le service refuse alors
# de demarrer sans lui. Vide en local = service ouvert, comme avant.
CV_SERVICE_TOKEN=
CV_SERVICE_TIMEOUT_MS=120000

# ─── Stockage des photos ─────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# ─── Retention des donnees (E6-1) ────────────────────────────────
# Delai entre la suppression logique d'un projet et son effacement definitif
# (lignes + fichiers), par la tache planifiee de 3 h. Doit rester STRICTEMENT
# SUPERIEUR a RETENTION_DAYS de docs/deploy/backup.sh (14 j), sans quoi une
# restauration ressusciterait une donnee deja effacee.
# Argumentaire complet : docs/RETENTION_DONNEES.md
DATA_RETENTION_DAYS=30
# Met la tache planifiee en observation : elle journalise ce qu'elle effacerait
# et n'efface rien. A laisser sur `true` le temps d'un cycle apres une mise en
# service, puis a repasser sur `false`.
DATA_RETENTION_DRY_RUN=false

# ─── Export des donnees personnelles (E6-2, RGPD art. 20) ───────────────
# Fenetre de telechargement d'une archive d'export, en heures. L'archive porte
# IBAN/BIC et des coordonnees clients : courte a dessein, purgee par la tache
# planifiee horaire.
EXPORT_RETENTION_HOURS=48

# ─── Frontend ────────────────────────────────────────────────────
# Figée au build de l'image web. Doit être une URL publique en HTTPS :
# localhost est refusé au démarrage en production.
NEXT_PUBLIC_API_URL=CHANGEME
# URL publique du site (SEO : sitemap, OpenGraph). Figée au build de l'image
# web. Doit être une URL publique en HTTPS : localhost est refusé au
# démarrage en production.
NEXT_PUBLIC_SITE_URL=CHANGEME

# ─── Sentry (monitoring, optionnel — no-op si absent) ────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# ─── Comparaison de prix ─────────────────────────────────────────
# Fraîcheur du cache de prix fournisseurs, en heures.
PRICE_CACHE_TTL_HOURS=24

# ─── ManoMano (affiliation, optionnel) ───────────────────────────
# Flux produits du programme d'affiliation, fourni par la plateforme
# (Awin, Effiliation…). L'URL porte le jeton du programme : ne jamais la
# committer. Un chemin local ou une URL file:// sont acceptés, ce qui permet
# de valider le rapprochement catalogue→produits sur un extrait de flux.
# Sans MANOMANO_ENABLED=true, aucun adaptateur n'est enregistré et la
# comparaison de prix ne renvoie rien.
MANOMANO_ENABLED=false
MANOMANO_FEED_URL=
MANOMANO_TIMEOUT_MS=120000
MANOMANO_FEED_TTL_HOURS=24

# ─── Leroy Merlin (affiliation, optionnel) ───────────────────────
# Même principe que ManoMano (BACKLOG BUY-4) : flux produits du programme
# d'affiliation, URL porteuse du jeton, jamais committée. Sans
# LEROY_MERLIN_ENABLED=true, aucun adaptateur n'est enregistré et aucun prix
# Leroy Merlin n'est servi.
LEROY_MERLIN_ENABLED=false
LEROY_MERLIN_FEED_URL=
LEROY_MERLIN_TIMEOUT_MS=120000
LEROY_MERLIN_FEED_TTL_HOURS=24
