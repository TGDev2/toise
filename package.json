{
  "name": "chiffreo",
  "private": true,
  "description": "Chiffréo — estimation de matériaux et chiffrage de travaux",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:api": "pnpm --filter @chiffreo/api dev",
    "dev:web": "pnpm --filter @chiffreo/web dev",
    "build:api": "pnpm --filter @chiffreo/api build",
    "build:web": "pnpm --filter @chiffreo/web build",
    "build:widget": "pnpm --filter @chiffreo/widget build",
    "test:api": "pnpm --filter @chiffreo/api test && pnpm --filter @chiffreo/api test:e2e",
    "test:web": "pnpm --filter @chiffreo/web test",
    "test:widget": "pnpm --filter @chiffreo/widget test",
    "lint": "pnpm --filter @chiffreo/api lint && pnpm --filter @chiffreo/web lint && pnpm --filter @chiffreo/widget lint",
    "dev:cv": "cd apps/cv-service && uvicorn app.main:app --reload --port 8000",
    "db:migrate": "pnpm --filter @chiffreo/api migration:run",
    "audit:ci": "pnpm audit --prod --audit-level critical"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": ">=7.5.5",
      "websocket-driver@<0.7.5": ">=0.7.5"
    }
  }
}
