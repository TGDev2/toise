{
  "name": "toise",
  "private": true,
  "description": "Toisé — estimation de matériaux et chiffrage de travaux",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:api": "pnpm --filter @toise/api dev",
    "dev:web": "pnpm --filter @toise/web dev",
    "build:api": "pnpm --filter @toise/api build",
    "build:web": "pnpm --filter @toise/web build",
    "test:api": "pnpm --filter @toise/api test && pnpm --filter @toise/api test:e2e",
    "test:api:integration": "pnpm --filter @toise/api test:integration",
    "test:web": "pnpm --filter @toise/web test",
    "lint": "pnpm --filter @toise/api lint && pnpm --filter @toise/web lint",
    "dev:cv": "cd apps/cv-service && uvicorn app.main:app --reload --port 8000",
    "db:migrate": "pnpm --filter @toise/api migration:run",
    "audit:ci": "pnpm audit --prod --audit-level critical"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": ">=7.5.5",
      "websocket-driver@<0.7.5": ">=0.7.5"
    }
  }
}
