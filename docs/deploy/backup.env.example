# Configuration de docs/deploy/backup.sh sur le VPS — OPS-3.
# Copier vers /etc/toise/backup.env :
#   sudo mkdir -p /etc/toise
#   sudo cp docs/deploy/backup.env.example /etc/toise/backup.env
#   sudo chmod 600 /etc/toise/backup.env && sudo chown root:root /etc/toise/backup.env
# Voir docs/deploy/BACKUP.md pour la procédure complète.

# Répertoire des sauvegardes chiffrées (créé automatiquement, chmod 700).
BACKUP_DIR=/var/backups/toise

# Rétention en jours : les fichiers plus anciens sont supprimés à chaque run.
RETENTION_DAYS=14

# Clé publique GPG destinataire (ID de clé, empreinte ou e-mail associé —
# doit être importée dans le trousseau root avant le premier run :
# gpg --import docs/deploy/toise-backup-pub.asc). La clé PRIVÉE
# correspondante ne doit jamais être présente sur ce VPS.
GPG_RECIPIENT=

# .env de l'application, source des identifiants DB_USERNAME/DB_PASSWORD/DB_NAME
# (source unique de vérité — non dupliqués ici).
APP_ENV_FILE=/opt/toise/.env

# Nom du conteneur Postgres et du volume uploads (valeurs par défaut de
# docker-compose.prod.yml — à ne changer que si la stack a été renommée).
DB_CONTAINER=toise-db
UPLOADS_VOLUME=toise_uploads

# ─── Copie hors-site (fortement recommandé) ─────────────────────────────
# Destination rclone recevant les fichiers chiffrés à la fin de chaque run.
# Sans elle, prod et sauvegardes vivent sur le même disque : une panne, un vol
# ou un chiffrement du VPS emporte les deux ensemble.
#   sudo apt install rclone && sudo rclone config   (une fois, en root)
# Exemples : b2:toise-backups/vps · s3:toise-backups · hetzner:backups
# Le script fait `rclone copy` (jamais `sync`) : le VPS ne peut pas effacer la
# copie distante. Régler la rétention distante côté fournisseur.
BACKUP_REMOTE=

# Optionnel : arguments supplémentaires passés à rclone (ex. --bwlimit 5M).
# RCLONE_FLAGS=

# ─── Supervision (fortement recommandé) ─────────────────────────────────
# URL de type healthchecks.io : pingée à la fin d'un run réussi, suffixée
# `/fail` en cas d'échec. Un cron qui ne tourne plus du tout est alors visible
# lui aussi — ce qu'une alerte purement « sur échec » ne voit jamais.
BACKUP_MONITOR_URL=

# ─── Divers ─────────────────────────────────────────────────────────────
# Image utilitaire lisant le volume uploads. Doit fournir GNU tar et GNU find
# (`tar --append`, `find -newermt`) — pas BusyBox.
# HELPER_IMAGE=debian:12-slim

# Optionnel : requête SQL exécutée par restore.sh après restauration, en plus
# du contrôle générique (nombre de tables). Exemple :
# SANITY_CHECK_SQL=select count(*) from projects;
