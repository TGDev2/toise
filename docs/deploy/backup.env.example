# Configuration de docs/deploy/backup.sh sur le VPS — OPS-3.
# Copier vers /etc/chiffreo/backup.env :
#   sudo mkdir -p /etc/chiffreo
#   sudo cp docs/deploy/backup.env.example /etc/chiffreo/backup.env
#   sudo chmod 600 /etc/chiffreo/backup.env && sudo chown root:root /etc/chiffreo/backup.env
# Voir docs/deploy/BACKUP.md pour la procédure complète.

# Répertoire des sauvegardes chiffrées (créé automatiquement, chmod 700).
BACKUP_DIR=/var/backups/chiffreo

# Rétention en jours : les fichiers plus anciens sont supprimés à chaque run.
RETENTION_DAYS=14

# Clé publique GPG destinataire (ID de clé, empreinte ou e-mail associé —
# doit être importée dans le trousseau root avant le premier run :
# gpg --import docs/deploy/chiffreo-backup-pub.asc). La clé PRIVÉE
# correspondante ne doit jamais être présente sur ce VPS.
GPG_RECIPIENT=

# .env de l'application, source des identifiants DB_USERNAME/DB_PASSWORD/DB_NAME
# (source unique de vérité — non dupliqués ici).
APP_ENV_FILE=/opt/chiffreo/.env

# Nom du conteneur Postgres et du volume uploads (valeurs par défaut de
# docker-compose.prod.yml — à ne changer que si la stack a été renommée).
DB_CONTAINER=chiffreo-db
UPLOADS_VOLUME=chiffreo_uploads

# Optionnel : requête SQL exécutée par restore.sh après restauration, en plus
# du contrôle générique (nombre de tables). Exemple :
# SANITY_CHECK_SQL=select count(*) from projects;
